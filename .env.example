# Optional. With a key here the app works on any device without pasting a key in Settings.
# This key is only ever used for free models (the proxy blocks paid ones), so it can't cost money.
OPENROUTER_API_KEY=

# Optional: the site's own OmniRoute gateway (https://www.omniroute.online), so OmniRoute works on
# every device without entering its address and key in the app. Both are needed.
# OmniRoute itself can't run on Netlify: run it on a cloud host or a computer and use its public
# https address (a cloud host's URL or its Cloudflare tunnel), e.g. https://omniroute.example.com
OMNIROUTE_URL=
# An API key from OmniRoute's Dashboard → API Keys. Anyone who can open this site can use it, so
# give it a quota there, or password-protect the site.
OMNIROUTE_API_KEY=
