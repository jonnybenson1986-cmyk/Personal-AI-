# Optional. With a key here the app works on any device without pasting a key in Settings.
# This key is only ever used for free models (the proxy blocks paid ones), so it can't cost money.
OPENROUTER_API_KEY=
# Optional. Require this passcode (entered in Settings) before anyone can use the key above,
# so strangers can't use up its free daily quota.
APP_PASSCODE=
